{
  "name": "newtecons-sql-readonly-mcp",
  "version": "1.0.0",
  "description": "Read-only MCP server (stdio) for Microsoft SQL Server, used by Claude Code. Independent from the Angular app.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "npm run build && node --test dist/sql-guard.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "mssql": "^12.7.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.20.2",
    "typescript": "~5.9.3"
  }
}
