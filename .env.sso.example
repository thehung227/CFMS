# Tài khoản SSO (Keycloak sso.newtecons.vn) cho script tools/browser-sso/login.mjs.
# Copy file này thành .env.sso (đã gitignore) rồi điền giá trị. KHÔNG commit .env.sso.
# Giá trị lấy nguyên văn sau dấu '=' (kể cả ký tự # hoặc =); có thể bọc trong "..." hoặc '...'.
SSO_EMAIL=
SSO_PASSWORD=

# Ứng dụng cần đăng nhập: http://localhost:4200 (npm start) hoặc https://cfms.newtecons.vn
APP_URL=http://localhost:4200
